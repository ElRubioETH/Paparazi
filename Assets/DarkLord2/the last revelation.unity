  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: d23d2c85386c32445a996f36734e570a, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  bookContent: "V\u0169 tr\u1EE5 b\u1EAFt \u0111\u1EA7u v\u1EDBi Big Bang c\xE1ch
    \u0111\xE2y kho\u1EA3ng 13,8 t\u1EF7 n\u0103m, t\u1EA1o ra kh\xF4ng gian, th\u1EDDi
    gian v\xE0 v\u1EADt ch\u1EA5t. C\xE1c nh\xE0 khoa h\u1ECDc tin r\u1EB1ng s\u1EF1
    gi\xE3n n\u1EDF nhanh ch\xF3ng sau \u0111\xF3 d\u1EABn \u0111\u1EBFn h\xECnh
    th\xE0nh c\xE1c thi\xEAn h\xE0. B\u1EB1ng ch\u1EE9ng ch\xEDnh l\xE0 b\u1EE9c
    x\u1EA1 n\u1EC1n vi s\xF3ng v\u0169 tr\u1EE5, ph\xE1t hi\u1EC7n b\u1EDFi Arno
    Penzias v\xE0 Robert Wilson. Tuy nhi\xEAn, v\u1EABn c\xF2n tranh c\xE3i v\u1EC1
    n\u0103ng l\u01B0\u1EE3ng t\u1ED1i, chi\u1EBFm 68% v\u0169 tr\u1EE5, \u1EA3nh
    h\u01B0\u1EDFng \u0111\u1EBFn t\u1ED1c \u0111\u1ED9 gi\xE3n n\u1EDF. C\xE1c k\xEDnh
    vi\u1EC5n v\u1ECDng hi\u1EC7n \u0111\u1EA1i nh\u01B0 James Webb gi\xFAp kh\xE1m
    ph\xE1 th\xEAm v\u1EC1 giai \u0111o\u1EA1n \u0111\u1EA7u c\u1EE7a v\u0169 tr\u1EE5."
  canvasText: {fileID: 160402017}
