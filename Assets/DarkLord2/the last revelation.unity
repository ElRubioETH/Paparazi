  m_Script: {fileID: 11500000, guid: 7e67828d3fbe45a4bb96facbe5c2a833, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  questions:
  - questionText: "B\u1EB1ng ch\u1EE9ng ch\xEDnh cho Big Bang l\xE0 g\xEC?"
    options:
    - "B\u1EE9c x\u1EA1 n\u1EC1n vi s\xF3ng v\u0169 tr\u1EE5 "
    - "Sao ch\u1ED5i Halley "
    - "V\xE0nh \u0111ai ti\u1EC3u h\xE0nh tinh "
    - "T\u1EEB tr\u01B0\u1EDDng m\u1EB7t tr\u1EDDi "
    correctAnswerIndex: 0
  - questionText: "Einstein nh\u1EADn Nobel v\xEC ph\xE1t hi\u1EC7n n\xE0o?"
    options:
    - "Thuy\u1EBFt t\u01B0\u01A1ng \u0111\u1ED1i "
    - "Hi\u1EC7u \u1EE9ng quang \u0111i\u1EC7n"
    - E=mc^2
    - "Nh\u1EADt Th\u1EF1c 1919"
    correctAnswerIndex: 1
  - questionText: "Ai ph\u1EBF tru\u1EA5t ho\xE0ng \u0111\u1EBF cu\u1ED1i c\xF9ng
      c\u1EE7a \u0110\u1EBF ch\u1EBF La M\xE3?"
    options:
    - Constantine
    - Nero
    - Julius Casear
    - Odoacer
    correctAnswerIndex: 3
  - questionText: "Maya d\u1EF1 \u0111o\xE1n ch\xEDnh x\xE1c chuy\u1EC3n \u0111\u1ED9ng
      c\u1EE7a sao n\xE0o?"
    options:
    - "Sao h\u1ECFa "
    - "Sao m\u1ED9c "
    - "Sao th\u1ED5"
    - 'Sao Kim '
    correctAnswerIndex: 3
  - questionText: "Ai ph\xE1t minh m\xE1y h\u01A1i n\u01B0\u1EDBc quan tr\u1ECDng
      trong C\xE1ch m\u1EA1ng C\xF4ng nghi\u1EC7p?"
    options:
    - Thomas Edison
    - Isaac Newton
    - James Watt
    - Michael Faraday
    correctAnswerIndex: 2
