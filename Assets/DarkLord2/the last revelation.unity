  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: d23d2c85386c32445a996f36734e570a, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  bookContent: "\u0110\u1EBF ch\u1EBF La M\xE3 s\u1EE5p \u0111\u1ED5 v\xE0o n\u0103m
    476 sau C\xF4ng nguy\xEAn, \u0111\xE1nh d\u1EA5u s\u1EF1 k\u1EBFt th\xFAc th\u1EDDi
    k\u1EF3 c\u1ED5 \u0111\u1EA1i. Nguy\xEAn nh\xE2n bao g\u1ED3m x\xE2m l\u01B0\u1EE3c
    t\u1EEB c\xE1c b\u1ED9 t\u1ED9c Germanic, suy tho\xE1i kinh t\u1EBF, v\xE0 s\u1EF1
    ph\xE2n chia gi\u1EEFa \u0110\xF4ng v\xE0 T\xE2y. Ho\xE0ng \u0111\u1EBF cu\u1ED1i
    c\xF9ng, Romulus Augustulus, b\u1ECB ph\u1EBF tru\u1EA5t b\u1EDFi Odoacer. Tuy
    nhi\xEAn, \u1EA3nh h\u01B0\u1EDFng c\u1EE7a La M\xE3 v\u1EABn t\u1ED3n t\u1EA1i
    qua lu\u1EADt ph\xE1p, ng\xF4n ng\u1EEF Latin, v\xE0 ki\u1EBFn tr\xFAc, nh\u01B0
    \u0111\u1EA5u tr\u01B0\u1EDDng Colosseum. S\u1EF1 s\u1EE5p \u0111\u1ED5 m\u1EDF
    \u0111\u01B0\u1EDDng cho Trung c\u1ED5 \u1EDF ch\xE2u \xC2u."
  canvasText: {fileID: 160402017}
