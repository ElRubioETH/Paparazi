MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1066467798}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: d23d2c85386c32445a996f36734e570a, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  bookContent: "V\u0103n minh Maya \u1EDF Trung M\u1EF9 ph\xE1t tri\u1EC3n t\u1EEB
    n\u0103m 2000 TCN, n\u1ED5i ti\u1EBFng v\u1EDBi ki\u1EBFn tr\xFAc kim t\u1EF1
    th\xE1p v\xE0 h\u1EC7 th\u1ED1ng ch\u1EEF vi\u1EBFt t\u01B0\u1EE3ng h\xECnh.
    H\u1ECD gi\u1ECFi thi\xEAn v\u0103n h\u1ECDc, d\u1EF1 \u0111o\xE1n ch\xEDnh x\xE1c
    chuy\u1EC3n \u0111\u1ED9ng sao Kim. Th\xE0nh ph\u1ED1 Chichen Itza c\xF3 kim
    t\u1EF1 th\xE1p El Castillo, ph\u1EA3n \xE1nh ki\u1EBFn th\u1EE9c to\xE1n h\u1ECDc
    v\xE0 thi\xEAn v\u0103n. V\u0103n minh suy t\xE0n v\xE0o th\u1EBF k\u1EF7 9,
    c\xF3 th\u1EC3 do bi\u1EBFn \u0111\u1ED5i kh\xED h\u1EADu v\xE0 chi\u1EBFn tranh.
    Di s\u1EA3n Maya v\u1EABn \u1EA3nh h\u01B0\u1EDFng \u0111\u1EBFn v\u0103n h\xF3a
    Mexico ng\xE0y nay."
  canvasText: {fileID: 160402017}
