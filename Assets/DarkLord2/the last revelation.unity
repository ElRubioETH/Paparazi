--- !u!114 &1299679505
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1299679500}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: d23d2c85386c32445a996f36734e570a, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  bookContent: "Albert Einstein ph\xE1t tri\u1EC3n thuy\u1EBFt t\u01B0\u01A1ng \u0111\u1ED1i,
    thay \u0111\u1ED5i c\xE1ch nh\xECn v\u1EC1 kh\xF4ng gian v\xE0 th\u1EDDi gian.
    Ph\u01B0\u01A1ng tr\xECnh E = mc\xB2 cho th\u1EA5y n\u0103ng l\u01B0\u1EE3ng
    v\xE0 kh\u1ED1i l\u01B0\u1EE3ng li\xEAn quan ch\u1EB7t ch\u1EBD, d\u1EABn \u0111\u1EBFn
    nghi\xEAn c\u1EE9u n\u0103ng l\u01B0\u1EE3ng h\u1EA1t nh\xE2n. Thuy\u1EBFt n\xE0y
    d\u1EF1 \u0111o\xE1n s\u1EF1 cong v\xEAnh kh\xF4ng gian do kh\u1ED1i l\u01B0\u1EE3ng
    l\u1EDBn, \u0111\u01B0\u1EE3c x\xE1c nh\u1EADn qua quan s\xE1t nh\u1EADt th\u1EF1c
    n\u0103m 1919. Einstein nh\u1EADn Nobel kh\xF4ng v\xEC thuy\u1EBFt t\u01B0\u01A1ng
    \u0111\u1ED1i m\xE0 v\xEC hi\u1EC7u \u1EE9ng quang \u0111i\u1EC7n. C\xF4ng tr\xECnh
    c\u1EE7a \xF4ng v\u1EABn l\xE0 n\u1EC1n t\u1EA3ng v\u1EADt l\xFD hi\u1EC7n \u0111\u1EA1i."
  canvasText: {fileID: 160402017}
