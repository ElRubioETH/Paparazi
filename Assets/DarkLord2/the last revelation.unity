  m_Script: {fileID: 11500000, guid: d23d2c85386c32445a996f36734e570a, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  bookContent: "C\xE1ch m\u1EA1ng C\xF4ng nghi\u1EC7p b\u1EAFt \u0111\u1EA7u \u1EDF
    Anh v\xE0o cu\u1ED1i th\u1EBF k\u1EF7 18, v\u1EDBi ph\xE1t minh m\xE1y h\u01A1i
    n\u01B0\u1EDBc c\u1EE7a James Watt. N\xF3 chuy\u1EC3n \u0111\u1ED5i x\xE3 h\u1ED9i
    t\u1EEB n\xF4ng nghi\u1EC7p sang c\xF4ng nghi\u1EC7p, v\u1EDBi nh\xE0 m\xE1y
    v\xE0 \u0111\u01B0\u1EDDng s\u1EAFt ph\xE1t tri\u1EC3n nhanh. S\u1EA3n xu\u1EA5t
    h\xE0ng lo\u1EA1t v\xE0 \u0111\xF4 th\u1ECB h\xF3a d\u1EABn \u0111\u1EBFn c\u1EA3i
    ti\u1EBFn kinh t\u1EBF nh\u01B0ng c\u0169ng g\xE2y \xF4 nhi\u1EC5m v\xE0 b\u1EA5t
    b\xECnh \u0111\u1EB3ng. Karl Marx ph\xEA ph\xE1n h\u1EC7 th\u1ED1ng n\xE0y, d\u1EABn
    \u0111\u1EBFn c\xE1c t\u01B0 t\u01B0\u1EDFng x\xE3 h\u1ED9i ch\u1EE7 ngh\u0129a.
    C\xF4ng ngh\u1EC7 hi\u1EC7n \u0111\u1EA1i ng\xE0y nay b\u1EAFt ngu\u1ED3n t\u1EEB
    giai \u0111o\u1EA1n n\xE0y."
  canvasText: {fileID: 160402017}
